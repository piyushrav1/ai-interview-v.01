{
  "name": "testmeman-ai-interviewer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @testmeman/api dev & pnpm --filter @testmeman/demo dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "vitest run",
    "lint:fix": "eslint --fix src test",
    "test:golden": "pnpm --filter @testmeman/core test:golden",
    "db:migrate": "pnpm --filter @testmeman/api db:migrate",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^22.9.0",
    "eslint": "^9.14.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.3.4",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^2.1.5"
  }
}